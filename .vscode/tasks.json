{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "typescript",
            "tsconfig": "tsconfig.json",
            "option": "watch",
            "group": "build",
            "label": "tsc: watch"
        },
        {
            "label": "serve",
            "type": "shell",
            "command": "npx",
            "args": ["http-server", "-p", "3000"],
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "$never"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Starting up",
                    "endsPattern": "Available on"
                }
            }
        }
    ]
}